<?xml version="1.0"?>
<tool id="seqtk" name="Seqtk" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@">
    <macros>
        <import>macros.xml</import>
    </macros>
    <expand macro="requirements"/>
    <command detect_errors="exit_code"><![CDATA[
        seqtk seq -a '$input' > '$output'
    ]]></command>
    <inputs>
        <param name="input" type="data" format="fasta" label="Input reads"/>
    </inputs>
    <outputs>
        <data name="output" format="fasta"/>
    </outputs>
    <tests>
        <test expect_num_outputs="1">
            <param name="input" value="reads.fasta"/>
        </test>
    </tests>
    <help format="markdown"><![CDATA[
Convert sequences to FASTA with seqtk.
    ]]></help>
    <xrefs>
        <xref type="bio.tools">seqtk</xref>
    </xrefs>
</tool>
